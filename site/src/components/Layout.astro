---
import {site,transition,show,latest} from '../lib/data.mjs';
import {topline} from '../lib/home.mjs';
const {title='오늘 호',description=site.masthead.tagline || 'AI 도구를 실무·창작에 바로 쓰려는 한국어 직장인·1인 창작자를 위한 매일의 정리',image='/og/issue-'+latest.issue_date+'.png',home=false,article=false}=Astro.props;
const base=process.env.SITE_URL || 'https://x-trend-b.vercel.app';
// 전환·미리보기 모드에서는 화면 본문과 같은 정리를 제목·설명 메타에도 적용한다(Astro가 속성 이스케이프).
const metaTitle=`${show(title)} — ${site.masthead.name}`, metaDesc=show(description);
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{metaTitle}</title><meta name="description" content={metaDesc}/><link rel="alternate" type="application/rss+xml" title={site.masthead.name} href="/rss.xml"/><link rel="canonical" href={new URL(Astro.url.pathname,base).href}/><meta property="og:title" content={metaTitle}/><meta property="og:description" content={metaDesc}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={new URL(Astro.url.pathname,base).href}/><meta property="og:image" content={new URL(image,base).href}/><meta name="twitter:card" content="summary_large_image"/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"/><link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"/><link rel="stylesheet" href="/style.css"/><script is:inline>try{const t=JSON.parse(localStorage.getItem('ac_theme'));if(t)document.documentElement.dataset.theme=t}catch{}</script></head><body><a class="skip" href="#main">본문 바로가기</a>{!home&&<header class="wrap compact"><Fragment set:html={topline(latest)}/><div class="bar"><a class="name" href="/">{site.masthead.name}</a><a class="back" href="/">오늘 호</a></div><div class="rules"></div></header>}<slot/><footer class="wrap" data-pagefind-ignore><div class="foot"><nav aria-label="매체 안내"><a href="/about/">소개</a><a href="/policy/">편집 방침</a><a href="/corrections/">정정 기록</a><a href="/rss.xml">RSS</a></nav><p>시안 단계: 일부 안내 문구는 임시{transition?' · 전환 모드':''}</p></div></footer><script src="/client.js" is:inline></script></body></html>
