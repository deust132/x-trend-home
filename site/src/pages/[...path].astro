---
import Layout from '../components/Layout.astro';
import {articles,issues,latest,site,weeklies,text,show,esc,byline,fill,DESK,articleHref,topicHref,dateLabel,bodyHTML} from '../lib/data.mjs';
import {PLACEHOLDER} from '../lib/defaults.mjs';
import {renderHome} from '../lib/home.mjs';
export function getStaticPaths(){return [{params:{path:undefined},props:{kind:'home',item:latest}},...issues.map(item=>({params:{path:'issues/'+item.issue_date},props:{kind:'home',item}})),...articles.map(item=>({params:{path:'a/'+item.slug},props:{kind:'article',item}})),...['agents','visual'].map(item=>({params:{path:'desk/'+item},props:{kind:'desk',item}})),...[...new Set(articles.map(a=>a.subtopic))].map(item=>({params:{path:'topic/'+item},props:{kind:'topic',item}})),...weeklies.map(item=>({params:{path:'weekly/'+item.week},props:{kind:'weeklyIssue',item}})),...['issues','search','weekly','about','policy','corrections'].map(kind=>({params:{path:kind},props:{kind}}))];}
const {kind,item}=Astro.props;
const names={issues:'지난 호',search:'검색',weekly:'주간 정리',about:'소개',policy:'편집 방침',corrections:'정정 기록'};
const title=kind==='home'?`제${item.issue_no}호 · ${item.issue_date}`:kind==='article'?item.title:kind==='desk'?DESK[item]+' 데스크':kind==='topic'?item:kind==='weeklyIssue'?item.title:names[kind];
const story=a=>`<li><span class="no">${String(a.number).padStart(2,'0')}</span><div><span class="kicker ${a.deskKey}">${text(a.kicker)}</span><h3><a href="${articleHref(a)}">${text(a.title)}</a></h3><p class="dek clamp-2">${text(a.dek)}</p><span class="meta">${a.issue_date} · 읽는 데 ${a.minutes}분<span data-read="${a.slug}"></span></span></div></li>`;
const chosen=kind==='desk'?articles.filter(a=>a.deskKey===item):kind==='topic'?articles.filter(a=>a.subtopic===item):[];
const groups=[...new Set(chosen.map(a=>a.issue_date))];
const corrections=articles.flatMap(a=>a.corrections.map(c=>({...c,article:a}))).sort((a,b)=>b.corrected_at.localeCompare(a.corrected_at));
const pos=kind==='article'?articles.indexOf(item):-1;
---
<Layout title={title} home={kind==='home'} article={kind==='article'} description={kind==='article'?item.dek:undefined} image={kind==='article'?'/og/'+item.slug+'.png':kind==='home'?'/og/issue-'+item.issue_date+'.png':undefined}>
{kind==='home'?<Fragment set:html={renderHome(item,{current:item===latest})}/>:<main id="main" class="wrap">
{kind==='article'?<article data-pagefind-body data-slug={item.slug} data-pagefind-meta={`date:${item.issue_date}`}>
<header class="story-head"><span class={`kicker ${item.deskKey}`} data-pagefind-meta="kicker">{show(item.kicker)}</span><h1 data-pagefind-meta="title" set:html={text(item.title)}/><p class="dek" data-pagefind-meta="dek" set:html={text(item.dek)}/><span class="meta">제{item.issue_no}호 · {dateLabel(item.issue_date)} · 읽는 데 {item.minutes}분</span><span class="meta byline">{byline()}</span></header>
<div class="reading"><div class="body">{Object.entries(item.body).filter(([key,value])=>value.trim()&&!(key==='what'&&value.trim()===item.dek.trim())).map(([key,value])=><section><h2>{{what:'무슨 일인가',how:'어떻게 작동하나',why:'왜 중요한가',try:'이렇게 써 보세요'}[key]}</h2><Fragment set:html={bodyHTML(value)}/></section>)}{item.media?.map(m=>m.kind==='video'?<video src={m.src} controls aria-label={m.alt}/>:<figure><img src={m.src} alt={m.alt}/>{m.caption&&<figcaption set:html={text(m.caption)}/>}</figure>)}{item.official_link&&<p class="official"><span class="meta">공식 페이지</span><a href={item.official_link.url} target="_blank" rel="noopener" set:html={text(item.official_link.label)}/></p>}{item.corrections.map(c=><p set:html={`정정(${esc(c.corrected_at)}): ${text(c.text)}`}/>)}<div class="share" data-pagefind-ignore><button type="button" id="copy">링크 복사</button><button type="button" id="share" hidden>공유</button><span id="share-status" role="status"></span></div></div>
<aside class="side" data-pagefind-ignore><div><h2>이 글의 주제</h2><p class="tags"><a href={topicHref(item.subtopic)}>{show(item.subtopic)}</a></p>{item.glossary.length>0&&<><div class="glossary-desktop"><h2>용어 풀이</h2>{item.glossary.map(g=><p><strong>{show(g.term)}</strong><br/>{show(g.definition)}</p>)}</div><details class="glossary-mobile"><summary>용어 풀이</summary>{item.glossary.map(g=><p><strong>{show(g.term)}</strong><br/>{show(g.definition)}</p>)}</details></>}<h2>같은 데스크 다른 글</h2><ol>{articles.filter(a=>a.deskKey===item.deskKey&&a.slug!==item.slug).slice(0,3).map(a=><li><span class={`kicker ${a.deskKey}`}>{show(a.kicker)}</span><h3><a href={articleHref(a)} set:html={text(a.title)}/></h3></li>)}</ol></div></aside></div>
<nav class="pager" aria-label="이전·다음 글" data-pagefind-ignore>{articles[pos-1]?<a href={articleHref(articles[pos-1])}><span class="meta">이전 글</span><h3 set:html={text(articles[pos-1].title)}/></a>:<span/>}{articles[pos+1]&&<a href={articleHref(articles[pos+1])}><span class="meta">다음 글</span><h3 set:html={text(articles[pos+1].title)}/></a>}</nav></article>:<><header class="story-head"><h1 set:html={text(title)}/></header>
{(kind==='desk'||kind==='topic')&&<><nav class="filters" aria-label="하위 주제">{(kind==='desk'?[...new Set(chosen.map(a=>a.subtopic))]:[]).map(t=><a href={topicHref(t)}>{show(t)}</a>)}</nav>{groups.map(date=><section class="desk"><h2>{dateLabel(date)}</h2><ol class="stories" set:html={chosen.filter(a=>a.issue_date===date).map(story).join('')}/></section>)}</>}
{kind==='issues'&&<ol class="issues archive">{issues.map(i=><li><a class="no" href={`/issues/${i.issue_date}/`}>제{i.issue_no}호</a><span class="meta">{dateLabel(i.issue_date)} · {i.articles.length}편</span><ul>{i.articles.slice(0,3).map(a=><li set:html={text(a.title)}/>)}</ul></li>)}</ol>}
{kind==='search'&&<section class="body"><label for="query">기사 검색</label><input id="query" type="search" placeholder="제목이나 본문 검색"/><p id="search-status" role="status">검색어를 입력해 주세요</p><ol class="stories" id="results"></ol><script is:inline type="module" src="/search.js"></script></section>}
{kind==='weekly'&&(weeklies.length?<ol class="stories">{weeklies.map(w=><li><a href={`/weekly/${w.week}/`}>{show(w.title)}</a></li>)}</ol>:<p class="empty">첫 주간 호는 준비 중</p>)}
{kind==='weeklyIssue'&&<div class="body"><Fragment set:html={bodyHTML(item.intro)}/>{item.picks.map(p=><section><h2><a href={articleHref(articles.find(a=>a.slug===p.slug))}>{show(articles.find(a=>a.slug===p.slug)?.title)}</a></h2><p>{show(p.note)}</p></section>)}{item.closing&&<p>{show(item.closing)}</p>}</div>}
{kind==='about'&&<div class="body"><p data-placeholder={!site.pages.about?'about':undefined}>{fill(site.pages.about || PLACEHOLDER.about)}</p><p>{fill(site.bot.label)}</p></div>}
{kind==='policy'&&<div class="body"><p data-placeholder={!site.pages.policy?'policy':undefined}>{fill(site.pages.policy || PLACEHOLDER.policy)}</p><p>{fill(site.bot.label)}</p>{site.pages.corrections_format&&<p class="dek"><strong>정정 표기</strong> {site.pages.corrections_format}</p>}</div>}
{kind==='corrections'&&(corrections.length?<ol class="body">{corrections.map(c=><li><a href={articleHref(c.article)} set:html={text(c.article.title)}/><p set:html={`정정(${esc(c.corrected_at)}): ${text(c.text)}`}/></li>)}</ol>:<p class="empty">아직 정정한 글이 없습니다</p>)}
</>}
</main>}
</Layout>
